  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Register": {
        "type": "object",
        "required": [
          "login",
          "password",
          "pin"
        ],
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Child": {
        "type": "object",
        "required": [
          "nickname",
          "grade",
          "age_band",
          "instruction_language",
          "avatar"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "age_band": {
            "type": "string",
            "enum": [
              "6-7",
              "8-9",
              "10-11"
            ]
          },
          "instruction_language": {
            "type": "string",
            "enum": [
              "ru-KZ",
              "kk-KZ"
            ]
          },
          "avatar": {
            "type": "string",
            "enum": [
              "owl",
              "fox",
              "cat"
            ]
          }
        }
      },
      "Consent": {
        "type": "object",
        "required": [
          "purpose",
          "version",
          "granted"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "learning",
              "voice",
              "photo",
              "research"
            ]
          },
          "version": {
            "type": "string",
            "enum": [
              "engineering-v1"
            ]
          },
          "granted": {
            "type": "boolean"
          }
        }
      },
      "Start": {
        "type": "object",
        "required": [
          "lesson_id"
        ],
        "properties": {
          "lesson_id": {
            "type": "string",
            "enum": [
              "engineering-addition-v1"
            ]
          }
        }
      },
      "Attempt": {
        "type": "object",
        "required": [
          "client_event_id",
          "task_revision",
          "step_id",
          "input"
        ],
        "properties": {
          "client_event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "task_revision": {
            "type": "integer"
          },
          "step_id": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "value"
            ]
          }
        }
      },
      "QuoteRequest": {
        "type": "object",
        "required": [
          "child_ids"
        ],
        "properties": {
          "child_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Tariff": {
        "type": "object",
        "required": [
          "name",
          "price_per_child_kzt",
          "max_saved_profiles"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "price_per_child_kzt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "max_saved_profiles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "revision": {
            "type": "integer",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "trial_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 3
          }
        }
      },
      "Empty": {
        "type": "object"
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message_key",
              "retryable",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message_key": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
